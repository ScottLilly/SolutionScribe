<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="SolutionScribe">
	  <Groups>
		  <Group guid="SolutionScribe" id="SolutionScribeMenuGroup" priority="0x0600">
			  <Parent guid="VSMainMenu" id="Tools"/>
		  </Group>
		  <!-- Its own group, so the shell draws a separator between it and the five
		       individual file commands. -->
		  <Group guid="SolutionScribe" id="SolutionScribeAllFilesGroup" priority="0x0050">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenu"/>
		  </Group>
		  <Group guid="SolutionScribe" id="SolutionScribeSubMenuGroup" priority="0x0100">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenu"/>
		  </Group>
	  </Groups>

	  <!-- Menus -->
	  <Menus>
		  <Menu guid="SolutionScribe" id="SolutionScribeSubMenu" priority="0x0100" type="Menu">
			  <Parent guid="SolutionScribe" id="SolutionScribeMenuGroup" />
			  <Strings>
				  <ButtonText>Solution Scribe</ButtonText>
			  </Strings>
		  </Menu>
	  </Menus>
	  
	  <!--This section defines the elements the user can interact with, like a menu command or a button or combo box in a toolbar. -->
	  <Buttons>
		  <Button guid="SolutionScribe" id="CreateAllDocumentationFilesCommand" priority="0x0100" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeAllFilesGroup" />
			  <Strings>
				  <ButtonText>Create all documentation files</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateLicenseFileCommand" priority="0x0200" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create LICENSE file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateReadmeFileCommand" priority="0x0201" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create README file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateContributingFileCommand" priority="0x0202" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create CONTRIBUTING file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateChangelogFileCommand" priority="0x0203" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create CHANGELOG file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateCodeOfConductFileCommand" priority="0x0204" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create CODE_OF_CONDUCT file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateSecurityFileCommand" priority="0x0205" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create SECURITY file</ButtonText>
			  </Strings>
		  </Button>

		  <Button guid="SolutionScribe" id="CreateGitHubTemplatesCommand" priority="0x0206" type="Button">
			  <Parent guid="SolutionScribe" id="SolutionScribeSubMenuGroup" />
			  <Strings>
				  <ButtonText>Create GitHub templates</ButtonText>
			  </Strings>
		  </Button>
	  </Buttons>
  </Commands>

	<!-- Every command writes into the solution folder, so none of them mean anything
	     without an open solution. Hiding them here rather than graying them out in a
	     BeforeQueryStatus override lets the shell decide without loading the package. -->
	<VisibilityConstraints>
		<VisibilityItem guid="SolutionScribe" id="SolutionScribeSubMenu" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateAllDocumentationFilesCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateLicenseFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateReadmeFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateContributingFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateChangelogFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateCodeOfConductFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateSecurityFileCommand" context="UICONTEXT_SolutionExists" />
		<VisibilityItem guid="SolutionScribe" id="CreateGitHubTemplatesCommand" context="UICONTEXT_SolutionExists" />
	</VisibilityConstraints>

	<Symbols>
		<GuidSymbol name="SolutionScribe" value="{c2a25aa6-71a0-4dd6-9974-49f9035e55a2}">
			<IDSymbol name="SolutionScribeMenuGroup" value="0x0001" />
			<IDSymbol name="SolutionScribeSubMenu" value="0x0100" />
			<IDSymbol name="SolutionScribeSubMenuGroup" value="0x0101" />
			<IDSymbol name="SolutionScribeAllFilesGroup" value="0x0102" />
			<IDSymbol name="CreateLicenseFileCommand" value="0x0200" />
			<IDSymbol name="CreateReadmeFileCommand" value="0x0201" />
			<IDSymbol name="CreateContributingFileCommand" value="0x0202" />
			<IDSymbol name="CreateChangelogFileCommand" value="0x0203" />
			<IDSymbol name="CreateCodeOfConductFileCommand" value="0x0204" />
			<IDSymbol name="CreateAllDocumentationFilesCommand" value="0x0205" />
			<IDSymbol name="CreateSecurityFileCommand" value="0x0206" />
			<IDSymbol name="CreateGitHubTemplatesCommand" value="0x0207" />
		</GuidSymbol>
	</Symbols>
	
</CommandTable>
