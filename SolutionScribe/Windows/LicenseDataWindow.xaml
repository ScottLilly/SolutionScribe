<platformUi:DialogWindow x:Class="SolutionScribe.Windows.LicenseDataWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                         Title="License Data"
                         Width="620"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         ShowInTaskbar="False"
                         WindowStartupLocation="CenterOwner">

    <!-- Nothing here sets a font, a color or a pixel position. DialogWindow merges Visual Studio's
         themed dialog styles, so the controls follow the IDE's theme and font, and WPF scales the
         layout with the IDE's DPI. -->

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label x:Name="LicenseTypeLabel"
               Grid.Row="0" Grid.Column="0"
               Margin="0,0,8,6"
               VerticalAlignment="Center"
               Content="_License Type:"
               Target="{Binding ElementName=LicenseTypes}" />

        <ComboBox x:Name="LicenseTypes"
                  Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,6"
                  DisplayMemberPath="LicenseName"
                  SelectionChanged="LicenseTypes_SelectionChanged" />

        <Label x:Name="CopyrightYearsLabel"
               Grid.Row="1" Grid.Column="0"
               Margin="0,0,8,6"
               VerticalAlignment="Center"
               Content="Copyright _Year(s):"
               Target="{Binding ElementName=CopyrightYears}" />

        <TextBox x:Name="CopyrightYears"
                 Grid.Row="1" Grid.Column="1"
                 Margin="0,0,0,6"
                 Width="150"
                 HorizontalAlignment="Left" />

        <Label x:Name="CopyrightHolderLabel"
               Grid.Row="2" Grid.Column="0"
               Margin="0,0,8,0"
               VerticalAlignment="Center"
               Content="Copyright _Holder:"
               Target="{Binding ElementName=CopyrightHolder}" />

        <TextBox x:Name="CopyrightHolder"
                 Grid.Row="2" Grid.Column="1" />

        <TextBlock x:Name="FixedTextNote"
                   Grid.Row="3" Grid.Column="1"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                   Text="This license text is fixed. The year and copyright holder are not used."
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button x:Name="CreateFileButton"
                    MinWidth="86"
                    MinHeight="24"
                    Margin="0,0,8,0"
                    Padding="12,2"
                    Content="Create File"
                    IsDefault="True"
                    Click="CreateFileButton_Click" />

            <Button x:Name="CancelDialogButton"
                    MinWidth="86"
                    MinHeight="24"
                    Padding="12,2"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
